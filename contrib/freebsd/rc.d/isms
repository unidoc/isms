#!/bin/sh

# PROVIDE: isms
# REQUIRE: cleanvar DAEMON NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="isms"
rcvar="isms_enable"

load_rc_config "$name"

: ${isms_enable:="NO"}
: ${isms_user:="isms"}
: ${isms_env_file:="/opt/isms/etc/server.env"}
: ${isms_logfile:="/var/log/isms.log"}

command="/opt/isms/bin/isms"
pidfile="/var/run/isms.pid"

start_cmd="isms_start"

isms_start()
{
        if [ ! -r "$isms_env_file" ]; then
                err 1 "$isms_env_file is not readable"
        fi

        set -a
        . "$isms_env_file"
        set +a

        /usr/sbin/daemon \
                -p "$pidfile" \
                -o "$isms_logfile" \
                -u "$isms_user" \
                "$command" \
                server serve
}

run_rc_command "$1"

